# .env のテンプレート。コピーして .env を作成し、鍵を差し替える:
#   cp .env.example .env
# 鍵生成例(PowerShell):
#   "sk-aihub-" + -join ((1..48) | % { '{0:x}' -f (Get-Random -Max 16) })
# 鍵生成例(bash):
#   echo "sk-aihub-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-aihub-REPLACE_WITH_LONG_RANDOM_STRING

# OpenClaw Control UI(:20802)のログイン用トークン。上と同じ要領で長い乱数にする:
#   echo "$(openssl rand -hex 32)"
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_LONG_RANDOM_STRING

# Strata 推論エンジン(:20803)の API キー。gateway → strata の認証と、Web UI / 直接 API 呼び出しに使う。
# 16 文字以上。上と同じ要領で長い乱数にする:
#   echo "$(openssl rand -hex 24)"
STRATA_API_KEY=REPLACE_WITH_LONG_RANDOM_STRING
